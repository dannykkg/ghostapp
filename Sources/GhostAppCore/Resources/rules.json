{
  "rules": [
    {
      "id": "grok-build",
      "displayName": "Grok Build",
      "managerNames": ["grok-build"],
      "executableNames": ["grok"],
      "executablePaths": ["$HOME/.grok/bin/agent"],
      "dataPaths": [
        {"path": "$HOME/.grok/bin", "kind": "installation", "sensitive": false},
        {"path": "$HOME/.grok/config.toml", "kind": "configuration", "sensitive": false},
        {"path": "$HOME/.grok/auth.json", "kind": "credential", "sensitive": true},
        {"path": "$HOME/.grok/sessions", "kind": "session", "sensitive": true},
        {"path": "$HOME/.grok/downloads", "kind": "cache", "sensitive": false},
        {"path": "$HOME/.grok/logs", "kind": "log", "sensitive": false},
        {"path": "$HOME/.grok/cache", "kind": "cache", "sensitive": false}
      ]
    },
    {
      "id": "antigravity-cli",
      "displayName": "Google Antigravity CLI",
      "managerNames": ["antigravity-cli", "agy"],
      "executableNames": ["agy"],
      "executablePaths": [],
      "dataPaths": [
        {"path": "$HOME/.gemini/antigravity-cli", "kind": "state", "sensitive": true}
      ]
    }
  ]
}
